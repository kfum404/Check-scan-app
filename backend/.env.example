# Скопируйте в .env и заполните
DATABASE_URL=postgresql+psycopg://checkscan:checkscan@localhost:5432/checkscan
JWT_SECRET=сгенерируйте-длинную-случайную-строку
JWT_EXPIRES_MINUTES=10080
UPLOAD_DIR=uploads
TESSERACT_LANG=rus+eng
TESSERACT_PSM=6
# Windows-разработка: путь к tesseract.exe, если он не в PATH (в Docker не нужно)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
CORS_ORIGINS=*
