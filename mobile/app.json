{
  "expo": {
    "name": "ЧекСкан",
    "slug": "checkscan",
    "version": "1.5.0",
    "orientation": "portrait",
    "scheme": "checkscan",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F6F7FB",
    "android": {
      "package": "com.checkscan.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Разрешите доступ к камере, чтобы сканировать чеки",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Разрешите доступ к галерее, чтобы выбрать фото чека"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "34bdc520-4486-4439-9090-8f74f6e0f5fd"
      },
      "googleClientId": "804963259419-omvo81o4d2ejjiuplq8hu97hlee4577g.apps.googleusercontent.com"
    },
    "owner": "spermirkss-team"
  }
}