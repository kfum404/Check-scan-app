{
  "expo": {
    "name": "ЧекСкан",
    "slug": "checkscan",
    "version": "1.4.0",
    "orientation": "portrait",
    "scheme": "checkscan",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F6F7FB",
    "android": {
      "package": "com.checkscan.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Разрешите доступ к камере, чтобы сканировать чеки"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Разрешите доступ к галерее, чтобы выбрать фото чека"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "34bdc520-4486-4439-9090-8f74f6e0f5fd"
      }
    },
    "owner": "spermirkss-team"
  }
}
